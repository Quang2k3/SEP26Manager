# Environment variables for Docker Compose & Spring Boot
# Copy this file to .env and update with your actual values

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/SEP26WMS
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here
POSTGRES_DB=SEP26WMS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILE=dev

# Gmail SMTP Configuration (REQUIRED for OTP emails)
# Go to https://myaccount.google.com/apppasswords to create an App Password
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# JWT Secret (REQUIRED - generate a strong base64-encoded key)
# Example: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration (for avatar upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
